<?xml version='1.0' encoding='utf-8'?>
<package format="3">
    <name>fer_driver</name>
    <version>0.1.0</version>
    <description>Direct libfranka arm and gripper drivers for FER.</description>
    <maintainer email="francesco.wanderlingh@unige.it">Francesco Wanderlingh</maintainer>
    <license>MIT</license>
    <buildtool_depend>ament_cmake</buildtool_depend>
    <depend>rclcpp</depend>
    <depend>fer_msgs</depend>
    <depend>fer_model</depend>
    <depend>sensor_msgs</depend>
    <depend>libfranka</depend>
    <depend>fer_ctrl</depend>
    <depend>ament_index_cpp</depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>ament_index_python</exec_depend>
    <test_depend>ament_cmake_gtest</test_depend>
    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
