  <description>Launch the complete FER ROS2 control architecture.</description>
  <maintainer email="francesco.wanderlingh@unige.it">Francesco Wanderlingh</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>fer_ctrl</exec_depend><exec_depend>fer_driver</exec_depend>
