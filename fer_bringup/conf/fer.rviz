Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: panda_link0
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/MarkerArray
      Name: Arm, joints, base and avoidance planes
      Enabled: true
      Topic:
        Value: visualization/joint_markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/InteractiveMarkers
      Name: Tool control
      Enabled: true
      Show Axes: true
      Show Descriptions: true
      Interactive Markers Namespace: tool_control
    - Class: rviz_default_plugins/TF
      Name: Frames
      Enabled: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Pitch: 0.45
      Yaw: 0.8
      Focal Point:
        X: 0.2
        Y: 0.0
        Z: 0.3
