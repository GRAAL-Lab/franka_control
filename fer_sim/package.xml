<?xml version='1.0' encoding='utf-8'?>
<package format="3">
    <name>fer_sim</name>
    <version>0.1.0</version>
    <description>Hardware-free FER kinematic simulator and RViz markers.</description>
    <maintainer email="francesco.wanderlingh@unige.it">Francesco Wanderlingh</maintainer>
    <license>MIT</license>
    <buildtool_depend>ament_cmake</buildtool_depend>
    <depend>rclcpp</depend>
    <depend>rosgraph_msgs</depend>
    <depend>fer_msgs</depend>
    <depend>fer_model</depend>
    <depend>sensor_msgs</depend>
    <depend>visualization_msgs</depend>
    <depend>interactive_markers</depend>
    <depend>tf2_ros</depend>
    <depend>libconfig++-dev</depend>
    <depend>fer_ctrl</depend>
    <depend>ament_index_cpp</depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>ament_index_python</exec_depend>
    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
