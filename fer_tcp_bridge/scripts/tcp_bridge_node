#!/usr/bin/env python3
"""Expose the FER command service as one JSON request and response per TCP line."""

import json
import queue
import socket
import socketserver
import threading
import time
from functools import partial

import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from fer_msgs.msg import ControlData, StateData
from fer_msgs.srv import ControlCommand


class PendingCommand:
    def __init__(self, payload):
        self.payload = payload
        self.completed = threading.Event()
        self.deadline = time.monotonic() + 5.0
        self.response = {'success': False, 'res': 'Controller service timed out'}


class ControlCommandServer(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


class ControlCommandHandler(socketserver.StreamRequestHandler):
    def handle(self):
        self.connection.settimeout(30.0)
        try:
            while True:
                line = self.rfile.readline(8193)
                if not line:
                    return
                if len(line) > 8192 or not line.endswith(b'\n'):
                    self.SendResponse({'success': False, 'res': 'Maximum line length is 8192 bytes'})
                    return
                self.SendResponse(self.ParseCommand(line))
        except (socket.timeout, OSError):
            return

    def ParseCommand(self, line):
        try:
            payload = json.loads(line)
            if not isinstance(payload, dict):
                raise ValueError('Expected a JSON object')
            if payload == {'op': 'state'}:
                return self.server.bridge.GetState()

            command = PendingCommand(payload)
            self.server.bridge.commandQueue.put_nowait(command)
            command.completed.wait(max(0.0, command.deadline - time.monotonic()))
            return command.response
        except (ValueError, TypeError, queue.Full) as exception:
            return {'success': False, 'res': str(exception) or 'Command queue is full'}

    def SendResponse(self, response):
        self.wfile.write(json.dumps(response, allow_nan=False).encode('utf-8') + b'\n')
        self.wfile.flush()


class FrankaTCPBridge(Node):
    def __init__(self):
        super().__init__('tcp_bridge_node')
        host = self.declare_parameter('host', '127.0.0.1').value
        port = self.declare_parameter('port', 9999).value
        if not isinstance(port, int) or not 1 <= port <= 65535:
            raise ValueError('TCP port must be in 1..65535')

        self.commandQueue = queue.Queue(maxsize=64)
        self.commandClient = self.create_client(ControlCommand, 'srv/control_command')
        self.stateMutex = threading.Lock()
        self.latestState = {}
        self.pendingRequests = {}
        self.stateDataSub = self.create_subscription(
            StateData, 'state/state_data', self.StateDataCB, qos_profile_sensor_data)
        self.controlDataSub = self.create_subscription(
            ControlData, 'ctrl/ctrl_data', self.ControlDataCB, 1)
        self.runTimer = self.create_timer(0.01, self.Run)

        self.server = ControlCommandServer((host, port), ControlCommandHandler)
        self.server.bridge = self
        self.serverThread = threading.Thread(
            target=self.server.serve_forever, kwargs={'poll_interval': 0.2}, daemon=True)
        self.serverThread.start()
        self.get_logger().info(f'FER TCP bridge listening on {host}:{port}')

    def StateDataCB(self, message):
        with self.stateMutex:
            self.latestState.update(
                connected=message.connected,
                control_active=message.control_active,
                has_error=message.has_error,
                error=message.error,
                joints=list(message.joint_state.position),
                commanded_torques=list(message.commanded_torques),
                feedback_received=time.monotonic(),
            )

    def ControlDataCB(self, message):
        with self.stateMutex:
            self.latestState.update(ctrl_state=message.ctrl_state, status=message.status)

    def GetState(self):
        with self.stateMutex:
            state = dict(self.latestState)
        receiveTime = state.pop('feedback_received', None)
        state['feedback_age'] = None if receiveTime is None else time.monotonic() - receiveTime
        return {'success': True, 'state': state}

    def Run(self):
        for future, command in list(self.pendingRequests.items()):
            if time.monotonic() >= command.deadline:
                self.commandClient.remove_pending_request(future)
                command.completed.set()
                del self.pendingRequests[future]

        for _ in range(8):
            try:
                command = self.commandQueue.get_nowait()
            except queue.Empty:
                break
            if time.monotonic() >= command.deadline:
                command.completed.set()
                continue
            self.SendCommand(command)

    def SendCommand(self, command):
        try:
            if not self.commandClient.service_is_ready():
                raise ValueError('Controller service is unavailable')
            request = ControlCommand.Request()
            requestFields = request.get_fields_and_field_types()
            for name, value in command.payload.items():
                if name not in requestFields:
                    raise ValueError(f'Unknown request field: {name}')
                setattr(request, name, value)

            future = self.commandClient.call_async(request)
            self.pendingRequests[future] = command
            future.add_done_callback(partial(self.CommandResponseCB, command=command))
        except (ValueError, TypeError, AssertionError) as exception:
            command.response = {'success': False, 'res': str(exception)}
            command.completed.set()

    def CommandResponseCB(self, future, command):
        if future not in self.pendingRequests:
            return
        del self.pendingRequests[future]
        try:
            response = future.result()
            command.response = {'success': response.success, 'res': response.res}
        except Exception as exception:
            command.response = {'success': False, 'res': str(exception)}
        command.completed.set()

    def Close(self):
        self.server.shutdown()
        self.server.server_close()
        self.serverThread.join(timeout=1.0)
        for command in self.pendingRequests.values():
            command.completed.set()


def main():
    rclpy.init()
    bridge = None
    try:
        bridge = FrankaTCPBridge()
        rclpy.spin(bridge)
    except KeyboardInterrupt:
        pass
    finally:
        if bridge is not None:
            bridge.Close()
            bridge.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
